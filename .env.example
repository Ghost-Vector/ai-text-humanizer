# Copy this file to .env and configure ONE provider.
# If several are configured, set HUMANIZER_PROVIDER=huggingface | ollama | anthropic to choose.

# Option 1: Hugging Face Inference Providers (https://huggingface.co/settings/tokens,
# token needs the "Make calls to Inference Providers" permission)
HF_TOKEN=
# HF_MODEL=moonshotai/Kimi-K3     # others: moonshotai/Kimi-K3.1-Pro, moonshotai/Kimi-K2.6

# Option 2: Ollama on this machine (free, no key; the Ollama app must be running)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:latest

# Option 3: Ollama Cloud (https://ollama.com/settings/keys, needs credits or a subscription)
# OLLAMA_API_KEY=
# OLLAMA_MODEL=kimi-k3

# Option 4: Anthropic (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=
# HUMANIZER_MODEL=claude-opus-5-5

# PORT=8000
